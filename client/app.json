{
  "expo": {
    "name": "BayMax",
    "slug": "baymax",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/baymax_robot.jpg"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.baymax.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow BayMax to access your microphone for voice typing.",
          "speechRecognitionPermission": "Allow BayMax to access speech recognition for voice typing."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "9337901a-bba9-4743-8f39-acecb63c4a29"
      }
    }
  }
}
